{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-manifest.schema.json",
  "title": "Project test manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "profiles", "gates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "project": {"type": "string", "minLength": 1},
    "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "type", "profiles", "timeout_seconds", "network", "writes_project", "required", "command"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "category": {"enum": ["preflight", "structure", "contract", "test", "integration", "ui", "security", "release", "hygiene", "stability"]},
          "type": {"enum": ["command", "browser"]},
          "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200},
          "network": {"enum": ["forbidden", "loopback-only", "optional", "required"]},
          "writes_project": {"type": "boolean"},
          "required": {"type": "boolean"},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "environment": {"type": "object", "additionalProperties": {"type": "string"}},
          "service": {"type": "object", "additionalProperties": false, "required": ["command", "health_url", "startup_timeout_seconds"], "properties": {"command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "health_url": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/"}, "startup_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "evidence_freshness": {"enum": ["existing", "generated"]},
          "failure_evidence": {"type": "string"}
        },
        "allOf": [{"if": {"properties": {"type": {"const": "browser"}}}, "then": {"required": ["service"]}}]
      }
    }
  }
}
